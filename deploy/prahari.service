[Unit]
Description=PRAHARI local camera and pan-tilt service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dtc
WorkingDirectory=/home/dtc/prahari-eo
EnvironmentFile=-/etc/prahari.env
ExecStartPre=/usr/bin/pinctrl set 12,4 op dl
ExecStart=/home/dtc/prahari-env/bin/python -m sentry.launch
ExecStopPost=/usr/bin/pinctrl set 12,4 op dl
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
